POSTGRES_DB=media_lab
POSTGRES_USER=media_lab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://media_lab:change-me@postgres:5432/media_lab
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_BUCKET=media
MEDIA_ROOT=/data/media
DOUYIN_COOKIE_FILE=

# Self-hosted provider. Install github.com/tamnd/douyin-cli locally or use the
# binary built into the Docker image. A fresh browser cookie may be required
# for protected video/comment surfaces.
DOUYIN_CLI_PATH=douyin
DOUYIN_CLI_PROFILE=
DOUYIN_COOKIE_FILE=

# Optional local transcription. Set to 1 after installing a compatible model/runtime.
ENABLE_TRANSCRIPTION=0
WHISPER_MODEL=small
