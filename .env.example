# Copy to .env and replace every CHANGE_ME value before docker compose up.
POSTGRES_DB=media_lab
POSTGRES_USER=media_lab
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://media_lab:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/media_lab
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME_RANDOM_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_RANDOM_MINIO_PASSWORD
S3_BUCKET=media
MEDIA_ROOT=/data/media

# Published ports stay on loopback by default. Change this only when an authenticated
# reverse proxy or another deliberate network boundary is in front of the service.
SELF_MEDIA_BIND_ADDRESS=127.0.0.1
SELF_MEDIA_API_PORT=8000
MINIO_CONSOLE_PORT=9001

# Self-hosted provider. Install github.com/tamnd/douyin-cli locally or use the
# binary built into the Docker image. A fresh browser cookie may be required
# for protected video/comment surfaces.
DOUYIN_CLI_PATH=douyin
DOUYIN_CLI_PROFILE=
DOUYIN_COOKIE_FILE=

# Optional local transcription. Set to 1 after installing a compatible model/runtime.
ENABLE_TRANSCRIPTION=0
WHISPER_MODEL=small
